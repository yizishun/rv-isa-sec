+s1 = if (rs1_p == 0) then 0 else X[rs1_p * 2 + 1] @ X[rs1_p * 2]
+shamt = w_uimm[5:0]
+
+shx = sign_extend(128, s1) >> shamt    // arithmetic shift, take low 64 bits
+
+if (shx <s 0xFFFFFFFF80000000):
