+ssh1_hi : bits(32) =
+    if s1_hi <_s 0xC0000000 then { vxsat = 1; 0x80000000 }
+    else if s1_hi >=_s 0x40000000 then { vxsat = 1; 0x7FFFFFFF }
+    else s1_hi << 1
+xadd_hi = to_bits(36, signed(ssh1_hi) + signed(s2_hi))
