+----
+// Equivalent to two PSSHL.HS operations on even/odd register pairs
+s1     = (rs1_p == 0) ? 0 : X[rs1_p*2+1] @ X[rs1_p*2]
+shamt  = X[rs2][7:0]
+sshamt = signed(shamt)
+
+for i = 0 .. 3:
+    a = unsigned(s1[(16*i+15):(16*i)])
+    if sshamt < 0:
+        // Right shift
+        do[(16*i+15):(16*i)] = (a >> (-sshamt))[15:0]
+    else:
