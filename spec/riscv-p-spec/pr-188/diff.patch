+
+[source,pseudocode]
+----
+// Equivalent to two PPAIRO.B operations on even/odd register pairs
+s1_lo = X[rs1_p * 2]
+s1_hi = X[rs1_p * 2 + 1]
+s2_lo = X[rs2_p * 2]
+s2_hi = X[rs2_p * 2 + 1]
+
+for i = 0 .. (XLEN/16 - 1):
+    s1_h = s1_lo[(16*i+15):(16*i)]
