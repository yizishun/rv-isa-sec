+s1_hi = X[rs1_p * 2 + 1]
+shamt = X[rs2][4:0]
+
+for i = 0 .. (XLEN/8 - 1):
+    b = s1_lo[(8*i+7):(8*i)]
+    d_lo[(8*i+7):(8*i)] = (zero_extend(32, b) >> shamt)[7:0]
+
+for i = 0 .. (XLEN/8 - 1):
+    b = s1_hi[(8*i+7):(8*i)]
+    d_hi[(8*i+7):(8*i)] = (zero_extend(32, b) >> shamt)[7:0]
