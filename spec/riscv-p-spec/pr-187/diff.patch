+    a = sign_extend(32, s1_lo[(16*i+15):(16*i)])
+    shx = a << imm
+    if shx < -2^15:
+        d_lo[(16*i+15):(16*i)] = 0x8000; vxsat = 1
+    else if shx > 2^15 - 1:
