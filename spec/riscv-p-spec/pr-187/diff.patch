+        d_hi[(16*i+15):(16*i)] = ((shifted + 1) >> 1)[15:0]
+    else:
+        result = a << sshamt
+        if result < -2^15:
+            d_hi[(16*i+15):(16*i)] = 0x8000; vxsat = 1
+        else if result > 2^15 - 1:
