+  let pw : int = 2 * scale_width_of(scale_fmt);
+  let block_size : int = if vtype[bs] == 0b1 then 16 else 32;
+  let S : int = (g.K_eff + block_size - 1) / block_size;
+  let R : int = g.lambda * g.EEW_C / pw;
