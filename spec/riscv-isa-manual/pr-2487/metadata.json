    "gists_url": "https://api.github.com/users/GH4169/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/GH4169/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/GH4169/subscriptions",
    "organizations_url": "https://api.github.com/users/GH4169/orgs",
