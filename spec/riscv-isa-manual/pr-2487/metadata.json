  "locked": false,
  "title": "Fix bit-width for RoundKeyB in vaeskf2.vi Sail pseudocode",
  "user": {
    "login": "GH4169",
    "id": 77192123,
    "node_id": "MDQ6VXNlcjc3MTkyMTIz",
    "avatar_url": "https://avatars.githubusercontent.com/u/77192123?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/GH4169",
