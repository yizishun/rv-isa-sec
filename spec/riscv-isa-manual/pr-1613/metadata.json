  "number": 1613,
  "state": "closed",
  "locked": false,
  "title": "Release the constraint to enable e8mf8 in EEW=32",
  "user": {
    "login": "sequencer",
    "id": 5791019,
    "node_id": "MDQ6VXNlcjU3OTEwMTk=",
    "avatar_url": "https://avatars.githubusercontent.com/u/5791019?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/sequencer",
    "html_url": "https://github.com/sequencer",
    "followers_url": "https://api.github.com/users/sequencer/followers",
