    "starred_url": "https://api.github.com/users/IainCRobertson/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/IainCRobertson/subscriptions",
    "organizations_url": "https://api.github.com/users/IainCRobertson/orgs",
    "repos_url": "https://api.github.com/users/IainCRobertson/repos",
    "events_url": "https://api.github.com/users/IainCRobertson/events{/privacy}",
    "received_events_url": "https://api.github.com/users/IainCRobertson/received_events",
