  "title": "Added inferable tail calls to section 3.1.1 and replaced inferable re…",
  "user": {
    "login": "IainCRobertson",
    "id": 48293834,
    "node_id": "MDQ6VXNlcjQ4MjkzODM0",
    "avatar_url": "https://avatars.githubusercontent.com/u/48293834?v=4",
