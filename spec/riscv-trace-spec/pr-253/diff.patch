+# Initialize branch predictor #############################################################################
+function bpred_init ()
+
+  if (discovery.bpred_size == 0)
+    return
+
+  for(i = 0; i < 2** discovery.bpred_size; i++)
+    bpred[i][1] = FALSE
+    bpred[i][0] = TRUE
+  return
