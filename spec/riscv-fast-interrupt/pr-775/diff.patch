+;; ==============================================================
+
+(draw-box "8" {:span 8 :borders {}})
+(draw-box "8" {:span 8 :borders {}})
+(draw-box "8" {:span 8 :borders {}})
+(draw-box "8" {:span 8 :borders {}})
+----
+
+and for RV64 like:
