  "title": "Clarify Atomic type alignment requirements",
  "user": {
    "login": "lenary",
    "id": 14548,
    "node_id": "MDQ6VXNlcjE0NTQ4",
    "avatar_url": "https://avatars.githubusercontent.com/u/14548?v=4",
