    "following_url": "https://api.github.com/users/LukeZhuang/following{/other_user}",
    "gists_url": "https://api.github.com/users/LukeZhuang/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/LukeZhuang/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/LukeZhuang/subscriptions",
    "organizations_url": "https://api.github.com/users/LukeZhuang/orgs",
    "repos_url": "https://api.github.com/users/LukeZhuang/repos",
    "events_url": "https://api.github.com/users/LukeZhuang/events{/privacy}",
