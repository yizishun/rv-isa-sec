  "title": "Clarify passing empty unions and arrays of empty structs/unions",
  "user": {
    "login": "tomeksowi",
    "id": 583410,
    "node_id": "MDQ6VXNlcjU4MzQxMA==",
    "avatar_url": "https://avatars.githubusercontent.com/u/583410?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/tomeksowi",
    "html_url": "https://github.com/tomeksowi",
    "followers_url": "https://api.github.com/users/tomeksowi/followers",
    "following_url": "https://api.github.com/users/tomeksowi/following{/other_user}",
    "gists_url": "https://api.github.com/users/tomeksowi/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/tomeksowi/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/tomeksowi/subscriptions",
    "organizations_url": "https://api.github.com/users/tomeksowi/orgs",
    "repos_url": "https://api.github.com/users/tomeksowi/repos",
    "events_url": "https://api.github.com/users/tomeksowi/events{/privacy}",
    "received_events_url": "https://api.github.com/users/tomeksowi/received_events",
