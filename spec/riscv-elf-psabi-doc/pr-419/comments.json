      "subscriptions_url": "https://api.github.com/users/xypron/subscriptions",
      "organizations_url": "https://api.github.com/users/xypron/orgs",
      "repos_url": "https://api.github.com/users/xypron/repos",
      "events_url": "https://api.github.com/users/xypron/events{/privacy}",
      "received_events_url": "https://api.github.com/users/xypron/received_events",
      "type": "User",
      "user_view_type": "public",
      "site_admin": false
    },
    "body": "This implies _BitInt(16) is stored differently than short on big-endian systems.\r\nI would suggest that the endianness of _BitInt(N) should match the endianness of the system.",
    "created_at": "2025-08-14T08:01:21Z",
