     rule_analyzer_i.trans_end    = trans_req->addr +
-                          ((int)pow(2, trans_req->size) * (trans_req->length + 1));
+                                   ((int)pow(2, trans_req->size) * (trans_req->length + 1));
     rule_analyzer_i.perm         = trans_perm;
     rule_analyzer_i.is_amo       = trans_req->is_amo;
     rule_analyzer_o.match_status = ENTRY_NOTMATCH;
