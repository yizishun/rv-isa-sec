+          return "ra, s0-s6";
+        }
+        if (rlist) == 12) {
+          return "ra, s0-s7";
+        }
+        if (rlist) == 13) {
+          return "ra, s0-s8";
+        }
+        if (rlist) == 14) {
+          return "ra, s0-s9";
+        }
+        if (rlist) == 15) {
+          return "ra, s0-s11";
+        }
+        raise(`Invalid rlist: ${rlist]}`);
     - name: spimm
       location: 3-2
-      left_shift: 4
+      #left_shift: 4
+      encode(operands): |
+        Xreg registers = 0;
+        if (operands[reg_range0] == "ra" || operands[reg_range0] == "x1") {
+          registers = registers + 1;
+          if (operands[reg_range1] == "s0" || operands[reg_range1] == "x8") {
+            registers = registers + 1;
+          } else if (operands[reg_range1] == "s0-s1") {
+            registers = registers + 2;
+          } else if (operands[reg_range1] == "s0-s2") {
+            registers = registers + 3;
+          } else if (operands[reg_range1] == "s0-s3") {
+            registers = registers + 4;
+          } else if (operands[reg_range1] == "s0-s4") {
+            registers = registers + 5;
+          } else if (operands[reg_range1] == "s0-s5") {
+            registers = registers + 6;
+          } else if (operands[reg_range1] == "s0-s6") {
+            registers = registers + 7;
+          } else if (operands[reg_range1] == "s0-s7") {
+            registers = registers + 8;
+          } else if (operands[reg_range1] == "s0-s8") {
+            registers = registers + 9;
+          } else if (operands[reg_range1] == "s0-s9") {
+            registers = registers + 10;
+          } else if (operands[reg_range1] == "s0-s9") {
+            registers = registers + 11;
+          } else if (operands[reg_range1] == "x8-x9") {
+            registers = registers + 2;
+            if (operands[reg_range2] == "x18") {
+              registers = registers + 1;
+            } else if (operands[reg_range2] == "x18-x19") {
+              registers = registers + 2;
+            } else if (operands[reg_range2] == "x18-x20") {
+              registers = registers + 3;
+            } else if (operands[reg_range2] == "x18-x21") {
+              registers = registers + 4;
+            } else if (operands[reg_range2] == "x18-x22") {
+              registers = registers + 5;
+            } else if (operands[reg_range2] == "x18-x23") {
+              registers = registers + 6;
+            } else if (operands[reg_range2] == "x18-x24") {
+              registers = registers + 7;
+            } else if (operands[reg_range2] == "x18-x25") {
+              registers = registers + 8;
+            } else if (operands[reg_range2] == "x18-x27") {
+              registers = registers + 9;
+            }
+          }
+        }
+        XReg bytes_per_register = xlen() / 8;
+        XReg register_space_bytes = registers * bytes_per_reg;
+        XReg register_space_bytes_aligned_16 = ((register_space_bytes + 15) / 16) * 16;
+        XReg additional_bytes = (-operands[stack_adj]) - register_space_bytes_aligned_16;
+        return additional_bytes >> 4;
+      decode(): |
+        XReg additional_bytes = spimm << 4;
+        XReg registers = rlist;
+        XReg bytes_per_register = xlen() / 8;
+        XReg register_space_bytes = registers * bytes_per_reg;
+        XReg register_space_bytes_aligned_16 = ((register_space_bytes + 15) / 16) * 16;
+        return -(register_space_bytes_aligned_16 + additional_bytes);
