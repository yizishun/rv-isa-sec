  "title": "fix: update c.nop encoding and assembly to support HINTs (#1177)",
  "user": {
    "login": "16srivarshitha",
    "id": 175467174,
    "node_id": "U_kgDOCnVqpg",
    "avatar_url": "https://avatars.githubusercontent.com/u/175467174?v=4",
