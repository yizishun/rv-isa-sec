    "starred_url": "https://api.github.com/users/16srivarshitha/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/16srivarshitha/subscriptions",
    "organizations_url": "https://api.github.com/users/16srivarshitha/orgs",
    "repos_url": "https://api.github.com/users/16srivarshitha/repos",
    "events_url": "https://api.github.com/users/16srivarshitha/events{/privacy}",
    "received_events_url": "https://api.github.com/users/16srivarshitha/received_events",
