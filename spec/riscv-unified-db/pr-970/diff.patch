+  class TestInput
+    def initialize
+      @io = StringIO.new
+      @pos = 0
+    end
+
+    def cli_fiber=(fiber)
+      @cli_fiber = fiber
+    end
+
+    def tty? = false
+
+    def puts(*args)
+      @io.puts(*args)
+    end
+
+    def print(*args)
+      @io.puts(*args)
+    end
+
+    def write(*args)
+      @io.puts(*args)
+    end
+
+    def gets
+      @io.seek @pos
+      result = @io.gets
+      @pos = @io.tell
+      @io.seek(0, IO::SEEK_END)
+      result
+    end
+
+    def getc
+      @io.seek @pos
+      result = @io.getc
+      @pos = @io.tell
+      @io.seek(0, IO::SEEK_END)
+      result
+    end
+
+    def empty?
+      @pos == @io.size
+    end
+
+    def peeks
+      @io.seek @pos
+      result = @io.gets
+      @io.seek(@pos, IO::SEEK_SET)
+      result
+    end
+
+    def wait_readable(*)
+      true
+    end
+
+    def ioctl(*)
+      80
+    end
+  end
+
+  class TestOutput
+    def initialize
+      @io = StringIO.new
+      @pos = 0
+    end
+
+    def puts(*args)
+      @io.puts(*args)
+      Fiber.yield
+    end
+
+    def print(*args)
+      @io.print(*args)
+      Fiber.yield
+    end
+
+    def write(*args)
+      @io.write(*args)
+      Fiber.yield
+    end
+
+    def sync=(*args)
+      @io.sync = *args
+    end
+
+    def sync
+      @io.sync
+    end
+
+    def gets
+      @io.seek @pos
+      result = @io.gets
+      @pos = @io.tell
+      @io.seek(0, IO::SEEK_END)
+      result
+    end
+  end
+  sig { params(io: TestOutput, pattern: Regexp).returns(String) }
+  def expect_line(io, pattern)
+    line = nil
+    begin
+      Timeout::timeout(5) do
+        loop do
+          @cli_fiber.resume if @cli_fiber.alive?
+          line = io.gets
+          unless line.nil?
+            puts line.inspect
+            puts pattern =~ line
+            if pattern =~ line
+              assert_match pattern, line # register that we passed a test
+              return line
+            end
+          end
+        end
+      end
+    rescue Timeout::Error
+      assert_match pattern, line
+    end
+  end
