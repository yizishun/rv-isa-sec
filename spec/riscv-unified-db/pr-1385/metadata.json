  "title": "fix: add missing sign_extend property to instructions with signed immediates",
  "user": {
    "login": "lucifer4330k",
    "id": 145686020,
    "node_id": "U_kgDOCK7-BA",
    "avatar_url": "https://avatars.githubusercontent.com/u/145686020?v=4",
