+  bit_27 = (n >> 3) & 1        # n[3]
+  bit_26 = (n >> 2) & 1        # n[2]
+  bit_21 = (n >> 1) & 1        # n[1]
+  bit_20 = n & 1               # n[0]
+
+  # Build the 32-bit match string:
+  # Bits: 31  30  29-28 27  26  25-22 21  20  19-15    14-12 11-7     6-0
+  #       1   n4  00    n3  n2  0111  n1  n0  -----    100   -----    1110011
+  match = "1#{bit_30}00#{bit_27}#{bit_26}0111#{bit_21}#{bit_20}-----100-----1110011"
