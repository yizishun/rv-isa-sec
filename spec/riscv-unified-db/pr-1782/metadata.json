  "title": "Fix TypeError in ParameterTerm#<=> when comparison_value types differ",
  "user": {
    "login": "jordancarlin",
    "id": 25440394,
    "node_id": "MDQ6VXNlcjI1NDQwMzk0",
    "avatar_url": "https://avatars.githubusercontent.com/u/25440394?v=4",
    "gravatar_id": "",
