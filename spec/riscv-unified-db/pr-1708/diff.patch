+        ;;
+    esac
+    echo "==> Uploading ${native_arch} assets to GitHub Release ${release_tag}..."
+    # Try to upload; if release doesn't exist, create it first (for parallel CI builds)
+    if ! gh release upload "${release_tag}" \
+      --repo riscv/riscv-unified-db \
