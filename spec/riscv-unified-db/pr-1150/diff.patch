+    when:
+      not: { name: E }
+  - name: x20
+    abi_mnemonics: [s4]
+    callee_saved: true
+    description: Callee-saved register.
+    when:
+      not: { name: E }
+  - name: x21
+    abi_mnemonics: [s5]
+    callee_saved: true
+    description: Callee-saved register.
+    when:
+      not: { name: E }
+  - name: x22
+    abi_mnemonics: [s6]
+    callee_saved: true
+    description: Callee-saved register.
+    when:
+      not: { name: E }
+  - name: x23
+    abi_mnemonics: [s7]
+    callee_saved: true
