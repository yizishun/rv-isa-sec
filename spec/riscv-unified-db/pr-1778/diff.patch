+int BCDDevice::HandleCommand(HTIFCOMMAND cmd)
+{
+  switch(cmd.command)
+  {
+  case READ:
+    //TODO:
+    break;
+  case WRITE:
+    //TODO: use deicated console, stdout for now
+    std::putchar(static_cast<int>(cmd.payload));
+    break;
+  default:
+    break;
+  }
+  return 0;
+}
