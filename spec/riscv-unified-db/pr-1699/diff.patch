diff --git a/tools/vscode/adocerb/syntaxes/adoc-ruby-injection.json b/tools/vscode/adocerb/syntaxes/adoc-ruby-injection.json
new file mode 100644
index 0000000000..e905ed4aa9
--- /dev/null
+++ b/tools/vscode/adocerb/syntaxes/adoc-ruby-injection.json
@@ -0,0 +1,81 @@
+{
+  "name": "Asciidoc (Ruby - ERB)",
+  "scopeName": "text.asciidoc.erb",
+  "fileTypes": ["adoc.erb"],
+  "injections": {
+    "L:text.asciidoc.erb": {
+      "patterns": [
+        {
+          "include": "#comment"
+        },
+        {
+          "include": "#tags"
+        }
+      ]
+    }
+  },
+  "patterns": [
+    {
+      "include": "text.asciidoc"
+    }
+  ],
+  "repository": {
+    "comment": {
+      "patterns": [
+        {
+          "begin": "<%+#",
+          "beginCaptures": {
+            "0": {
+              "name": "punctuation.definition.comment.begin.erb"
+            }
+          },
+          "end": "%>",
+          "endCaptures": {
+            "0": {
+              "name": "punctuation.definition.comment.end.erb"
+            }
+          },
+          "name": "comment.block.erb"
+        }
+      ]
+    },
+    "tags": {
+      "patterns": [
+        {
+          "comment": "ERB block",
+          "begin": "<%+(?!>)[-=]?",
+          "beginCaptures": {
+            "0": {
+              "name": "punctuation.section.embedded.begin.erb"
+            }
+          },
+          "end": "(-?)%>",
+          "endCaptures": {
+            "0": {
+              "name": "punctuation.section.embedded.end.erb"
+            },
+            "1": {
+              "name": "punctuation.whitespace.embedded.erb"
+            }
+          },
+          "name": "meta.embedded.block.erb",
+          "contentName": "source.ruby.embedded.erb",
+          "patterns": [
+            {
+              "captures": {
+                "1": {
+                  "name": "punctuation.definition.comment.erb"
+                }
+              },
+              "match": "(#).*?(?=-?%>)",
+              "name": "comment.line.number-sign.erb"
+            },
+            {
+              "include": "source.ruby"
+            }
+          ]
+        }
+      ]
+    }
+  }
+}
