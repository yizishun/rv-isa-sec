+// Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+
+// Test file for C++ ERB injection
+
+// Single line ERB
+<% x = 5 %>
+
+// Single line ERB with trim
+<%- y = 10 -%>
+
+// Multiline ERB block
+<%
+  a = 1
+  b = 2
+%>
+
+// Multiline ERB block with trim
+<%-
+  c = 3
+  d = 4
+-%>
+
+// Multiline ERB block with trim and blank line after opening
+<%-
+
+  csrs = cfg_arch.not_prohibited_csrs
+
+-%>
+
+// ERB with output
+<%= some_value %>
+
+// ERB with output and trim
+<%=- other_value -%>
+
+int main() {
+  return 0;
+}
