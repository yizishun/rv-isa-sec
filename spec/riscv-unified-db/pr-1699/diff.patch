@@ -0,0 +1,23 @@
+<!--
+Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+SPDX-License-Identifier: BSD-3-Clause-Clear
+-->
+
+# C++ ERB Template Support for Visual Studio Code
+
+This extension provides syntax highlighting for C++ files with embedded Ruby ERB templating.
+
+## Features
+
+- Syntax highlighting for `.cpp.erb`, `.h.erb`, `.hpp.erb`, `.hxx.erb`, and `.cxx.erb` files
+- Ruby syntax highlighting within ERB tags (`<% %>`, `<%- -%>`, `<%= %>`)
+- Support for multiline ERB blocks
+- C++ syntax highlighting for the base file
+
+## Usage
+
+Files with the `.erb` extension combined with C++ extensions will automatically use this syntax highlighting.
+
+## License
+
+See LICENSE file for details.
diff --git a/tools/vscode/cpperb/language-configuration-cpperb.json b/tools/vscode/cpperb/language-configuration-cpperb.json
new file mode 100644
index 0000000000..b0c9db4068
--- /dev/null
+++ b/tools/vscode/cpperb/language-configuration-cpperb.json
@@ -0,0 +1,44 @@
+{
+  "comments": {
+    "lineComment": "//",
+    "blockComment": ["/*", "*/"]
+  },
+  "brackets": [
+    ["{", "}"],
+    ["[", "]"],
+    ["(", ")"]
+  ],
+  "autoClosingPairs": [
+    { "open": "[", "close": "]" },
+    { "open": "{", "close": "}" },
+    { "open": "(", "close": ")" },
+    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
+    { "open": "\"", "close": "\"", "notIn": ["string"] },
+    { "open": "/*", "close": "*/", "notIn": ["string", "comment"] },
+    { "open": "/**", "close": " */", "notIn": ["string"] }
+  ],
+  "surroundingPairs": [
+    ["{", "}"],
+    ["[", "]"],
+    ["(", ")"],
+    ["\"", "\""],
+    ["'", "'"],
+    ["<", ">"]
+  ],
+  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
+  "folding": {
+    "markers": {
+      "start": "^\\s*#pragma\\s+region\\b",
+      "end": "^\\s*#pragma\\s+endregion\\b"
+    }
+  },
+  "onEnterRules": [
+    {
+      "previousLineText": "^\\s*(((else ?)?if|for|while)\\s*\\(.*\\)\\s*|else\\s*)$",
+      "beforeText": "^\\s+([^{i\\s]|i(?!f\\b))",
+      "action": {
+        "indent": "outdent"
+      }
+    }
+  ]
+}
