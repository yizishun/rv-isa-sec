+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+# yaml-language-server: $schema=../../schemas/csr_schema.json
+
+$schema: "csr_schema.json#"
+kind: csr
+name: vxsat
+long_name: Vector Fixed-Point Saturate Flag
+address: 0x009
+writable: true
+priv_mode: U
+length: MXLEN
+description: Indicates if a fixed-point instruction has had to saturate an output value to fit into a destination format
+definedBy:
+  extension:
+    name: V
+sw_read(): |
+  return CSR[vcsr].VXSAT;
+fields:
+  VALUE:
+    location_rv32: 31-0
+    location_rv64: 63-0
+    description: |
+      The vxsat CSR has a single read-write least-significant bit (vxsat[0]) that indicates if a fixed-point
+      instruction has had to saturate an output value to fit into a destination format. Bits vxsat[XLEN-1:1]
+      should be written as zeros.
+
+      The vxsat bit is mirrored in vcsr.
+    sw_write(csr_value): |
+      return csr_value.VALUE & 1;
+    type: RW-H
+    reset_value: UNDEFINED_LEGAL
diff --git a/spec/std/isa/inst/V/vadd.vv.yaml b/spec/std/isa/inst/V/vadd.vv.yaml
index 019816829d..addc9cb9bb 100644
--- a/spec/std/isa/inst/V/vadd.vv.yaml
+++ b/spec/std/isa/inst/V/vadd.vv.yaml
@@ -1,4 +1,5 @@
 # Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+
 # SPDX-License-Identifier: BSD-3-Clause-Clear
 
 # yaml-language-server: $schema=../../../../schemas/inst_schema.json
@@ -6,9 +7,9 @@
 $schema: "inst_schema.json#"
 kind: instruction
 name: vadd.vv
-long_name: No synopsis available
+long_name: Vector-vector integer addition
 description: |
-  No description available.
+  Add source vector register groups from vs1 and vs2 according to mask vm and store results in vd.
 definedBy:
   extension:
     name: V
@@ -31,6 +32,29 @@ access:
   vu: always
 data_independent_timing: true
 operation(): |
+  VectorState state = vector_state();
+  VectorLmulType lmul_type = state.lmul_type;
+
+  XReg vlen = VLEN;
+  XReg vlmax;
+  if (lmul_type == VectorLmulType::Multiply) {
+    vlmax = (vlen << state.log2_lmul) >> state.log2_sew;
+  } else {
+    # (lmul_type == VectorLmulType::Divide)
+    vlmax = (vlen >> state.log2_lmul) >> state.log2_sew;
+  }
+
+  for (U32 i = CSR[vstart].VALUE; i < vlmax; i++) {
+    U32 start_bit_pos = i * state.sew;
+    U32 end_bit_pos = start_bit_pos + state.sew - 1;
+    v[vd] = {
+      v[vd][VLEN-1:end_bit_pos + 1],
+      (v[vs2])[end_bit_pos:start_bit_pos] + (v[vs1])[end_bit_pos:start_bit_pos],
+      v[vd][start_bit_pos-1:0]
+      };
+  }
+
+  CSR[vstart].VALUE = 0;
 
