+  def test_post_increment_does_not_leak
+    # i++ is the update expression in a for loop; after the loop, a variable
+    # assigned using i should remain unknown
+    orig_idl = <<~IDL
+      Bits<32> result = 0;
+      for (Bits<8> i = 0; i < 4; i++) {
+        result = i;
+      }
+      Bits<32> final = result;
+    IDL
+    expected_idl = <<~IDL
+      Bits<32> result = 0;
+      for (Bits<8> i = 0; i < 4; i++) {
+        result = i;
+      }
+      Bits<32> final = result;
+    IDL
