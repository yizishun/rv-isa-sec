+    expected_ast = @compiler.compile_func_body(
+      expected_idl,
+      return_type: Idl::Type.new(:bits, width: 32),
+      symtab:,
+      input_file: "temp"
+    )
+    refute_nil(expected_ast)
+    assert_equal expected_ast.to_idl, pruned_ast.to_idl
+  end
 end
