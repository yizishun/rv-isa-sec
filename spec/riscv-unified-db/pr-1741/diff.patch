-<%= portfolio_design.include_erb("normative_rules.adoc.erb", { "db_obj" => csr, "org" => "sep" }) %>
-<% csr.possible_fields.each do |field| -%>
-<%= portfolio_design.include_erb("normative_rules.adoc.erb", { "db_obj" => field, "org" => "sep" }) %>
-<% end -%>
-<% end -%>
