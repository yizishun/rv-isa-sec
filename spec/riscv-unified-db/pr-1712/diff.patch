+          indent: Integer
+        ).void
+      }
+      def initialize(line, column, content, type, indent)
+        @line = T.let(line, Integer)
+        @column = T.let(column, Integer)
+        @content = T.let(content, String)
+        @type = T.let(type, Symbol)
+        @indent = T.let(indent, Integer)
+      end
+
+      sig { returns(String) }
