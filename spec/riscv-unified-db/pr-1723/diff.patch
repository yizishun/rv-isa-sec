+  background: var(--ifm-background-color);
+}
+
+.idl-card:hover {
+  border-color: var(--ifm-color-primary);
+  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
+  transform: translateY(-2px);
+}
+
+[data-theme='dark'] .idl-card:hover {
+  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
+}
+
+[data-theme='dark'] {
+  /* UDB logo colors for dark mode - white on dark for maximum readability */
+  --udb-logo-primary: #FFFFFF;  /* White/near-white for main logo body */
+  --udb-logo-accent: #FFB800;   /* Vibrant gold for accent */
+
+  /* IDL logo colors for dark mode */
+  --idl-logo-bg: #161b22;       /* IDL logo background (dark mode) */
+  --idl-logo-fg: #33f1ff;       /* IDL logo foreground (cyan) */
+
+  /* Primary brand color adjusted for dark mode */
+  --ifm-color-primary: #7B8CDE;
+  --ifm-color-primary-dark: #6377d8;
+  --ifm-color-primary-darker: #566cd5;
+  --ifm-color-primary-darkest: #3852c7;
+  --ifm-color-primary-light: #93a1e4;
+  --ifm-color-primary-lighter: #a1ace7;
+  --ifm-color-primary-lightest: #c1c9f0;
+  --docusaurus-highlighted-code-line-bg: rgba(0, 0, 0, 0.3);
+}
diff --git a/doc/src/pages/index.module.css b/doc/src/pages/index.module.css
