  {
    "sha": "0d4af87aaebd2a9b7fd5f768dc59459652b314dd",
    "node_id": "C_kwDOMngV7toAKDBkNGFmODdhYWViZDJhOWI3ZmQ1Zjc2OGRjNTk0NTk2NTJiMzE0ZGQ",
    "commit": {
      "author": {
        "name": "Afonso Oliveira",
        "email": "Afonso.Oliveira@synopsys.com",
        "date": "2026-02-01T16:09:57Z"
      },
      "committer": {
        "name": "Afonso Oliveira",
        "email": "Afonso.Oliveira@synopsys.com",
        "date": "2026-02-01T16:09:57Z"
      },
      "message": "Add XAIFoundry custom extensions for ET-SoC-1 ET-Minion cores\n\nAdd 259 YAML files describing the Esperanto ET-SoC-1 custom ISA extensions\nunder spec/custom/isa/aifoundry/, organized into 10 extensions:\n\n- XAIFoundry: Parent umbrella extension\n- XAIFoundryps: Packed Single (8×FP32 SIMD) — 81 instructions, 1 CSR\n- XAIFoundrypi: Packed Integer (8×INT32 SIMD) — 37 instructions\n- XAIFoundrymask: Mask register operations — 9 instructions\n- XAIFoundryamo: Local/Global atomics — 82 instructions\n- XAIFoundrytensor: Matrix multiply / tensor ops — 19 instructions, 5 CSRs\n- XAIFoundrycache: Cache control — 6 instructions, 2 CSRs\n- XAIFoundryflb: Fast Local Barrier — 1 instruction\n- XAIFoundryfcc: Fast Credit Counter — 2 CSRs\n- XAIFoundryipi: Inter-Processor Interrupt (description only)\n\nAlso includes 4 general CSRs (minstmask, minstmatch, cache_invalidate, excl_mode).\n\nCo-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>",
      "tree": {
        "sha": "04297e983fc2f03af4751bf4d1178032fc607cd9",
        "url": "https://api.github.com/repos/riscv/riscv-unified-db/git/trees/04297e983fc2f03af4751bf4d1178032fc607cd9"
