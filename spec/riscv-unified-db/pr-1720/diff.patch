+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+# yaml-language-server: $schema=https://github.com/open-rpc/meta-schema/releases/download/1.14.9/open-rpc-meta-schema.json
+
+openrpc: "1.3.2"
+info:
+  title: UDB JSON-RPC API
+  version: "0.1.0"
+  description: |
+    JSON-RPC 2.0 API for the RISC-V Unified Database.
+    Provides programmatic access to RISC-V architecture data.
+methods:
+  - name: list_extensions
+    summary: List all extensions for the configured architecture
+    description: |
+      Returns all RISC-V extensions available in the configured architecture,
+      including their names, long names, versions, and instruction counts.
+    params: []
+    result:
+      name: extensions_result
+      description: List of extensions with metadata
+      schema:
+        type: object
+        required: [extensions, count]
+        properties:
+          extensions:
+            type: array
+            items:
+              type: object
+              required: [name, long_name, versions, instruction_count]
+              properties:
+                name:
+                  type: string
+                  description: Short extension name (e.g., "I", "M", "A")
+                long_name:
+                  type: string
+                  description: Full extension name
+                versions:
+                  type: array
+                  items:
+                    type: string
+                  description: List of version strings
+                instruction_count:
+                  type: integer
+                  minimum: 0
+                  description: Number of instructions defined by this extension
+          count:
+            type: integer
+            minimum: 0
+            description: Total number of extensions
+    errors:
+      - code: -32603
+        message: Internal error
+        data:
+          type: string
diff --git a/tools/ruby-gems/udb/templates/api-reference.md.erb b/tools/ruby-gems/udb/templates/api-reference.md.erb
new file mode 100644
index 0000000000..ffc8fee087
--- /dev/null
+++ b/tools/ruby-gems/udb/templates/api-reference.md.erb
@@ -0,0 +1,129 @@
+<!--
+Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+SPDX-License-Identifier: BSD-3-Clause-Clear
+-->
+
+
+---
+sidebar_position: 2
+---
+
+# API Reference
+
+> **API Version:** <%= spec["info"]["version"] %>
+> **OpenRPC Version:** <%= spec["openrpc"] %>
+
+<%= spec["info"]["description"].strip %>
+
+---
+
+<% spec["methods"].each do |method| -%>
+## `<%= method["name"] %>`
+
+**<%= method["summary"] %>**
+
+<%= method["description"].strip %>
+
+### Parameters
+
+<% if method["params"].nil? || method["params"].empty? -%>
+This method takes no parameters.
+<% else -%>
+| Name | Type | Required | Description |
+|------|------|----------|-------------|
+<% method["params"].each do |param| -%>
+| `<%= param["name"] %>` | `<%= param.dig("schema", "type") || "any" %>` | <%= param["required"] ? "Yes" : "No" %> | <%= param["description"] || "" %> |
+<% end -%>
+<% end -%>
+
+### Result
+
+**Name:** `<%= method.dig("result", "name") %>`
+
+<%= method.dig("result", "description") %>
+
+<% result_schema = method.dig("result", "schema") -%>
+<% if result_schema -%>
+#### Result Schema
+
+```json
+<%= JSON.pretty_generate(result_schema) %>
+```
+<% end -%>
+
+### Errors
+
+<% errors = method["errors"] -%>
+<% if errors.nil? || errors.empty? -%>
+No method-specific errors. Standard JSON-RPC 2.0 errors apply.
+<% else -%>
+| Code | Message | Description |
+|------|---------|-------------|
+<% errors.each do |err| -%>
+| `<%= err["code"] %>` | <%= err["message"] %> | <%= err.dig("data", "type") ? "Error detail: `#{err.dig("data", "type")}`" : "" %> |
+<% end -%>
+<% end -%>
+
+### Example
+
+**Request:**
+
+```json
+{
+  "jsonrpc": "2.0",
+  "method": "<%= method["name"] %>",
+  "params": {},
+  "id": 1
+}
+```
+
+**Response:**
+
+```json
+{
+  "jsonrpc": "2.0",
+  "result": { ... },
+  "id": 1
+}
+```
+
+---
+
+<% end -%>
+
+## `rpc.discover`
+
+**Returns the OpenRPC service discovery document.**
+
+This built-in method returns the full machine-readable API specification
+following the [OpenRPC 1.3.2](https://open-rpc.org/) standard.
+
+### Parameters
+
+This method takes no parameters.
+
+### Example
+
+**Request:**
+
+```json
+{
+  "jsonrpc": "2.0",
+  "method": "rpc.discover",
+  "params": {},
+  "id": 1
+}
+```
+
+**Response:**
+
+```json
+{
+  "jsonrpc": "2.0",
+  "result": {
+    "openrpc": "1.3.2",
+    "info": { "title": "UDB JSON-RPC API", "version": "0.1.0" },
+    "methods": [ ... ]
+  },
+  "id": 1
+}
