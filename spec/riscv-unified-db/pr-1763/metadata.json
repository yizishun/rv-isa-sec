  "locked": false,
  "title": "fix(JVT_BASE_MASK): allow fully-writable jvt.BASE on RV32",
  "user": {
    "login": "karabambus",
    "id": 8115959,
    "node_id": "MDQ6VXNlcjgxMTU5NTk=",
    "avatar_url": "https://avatars.githubusercontent.com/u/8115959?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/karabambus",
    "html_url": "https://github.com/karabambus",
    "followers_url": "https://api.github.com/users/karabambus/followers",
    "following_url": "https://api.github.com/users/karabambus/following{/other_user}",
    "gists_url": "https://api.github.com/users/karabambus/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/karabambus/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/karabambus/subscriptions",
    "organizations_url": "https://api.github.com/users/karabambus/orgs",
    "repos_url": "https://api.github.com/users/karabambus/repos",
    "events_url": "https://api.github.com/users/karabambus/events{/privacy}",
    "received_events_url": "https://api.github.com/users/karabambus/received_events",
